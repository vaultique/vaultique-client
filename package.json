{
  "name": "vaultique-client",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky install",
    "commit": "git-cz",
    "test:lint": "eslint .",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "win:dev": "tauri dev"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@popperjs/core": "^2.11.8",
    "@tauri-apps/api": "2.3.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "naive-ui": "^2.41.0",
    "object-hash": "^3.0.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.11.0",
    "@tauri-apps/cli": "2.3.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.13.9",
    "@types/object-hash": "^3.0.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.11.1",
    "eslint": "^9.23.0",
    "husky": "^9.1.7",
    "less": "^4.2.2",
    "lint-staged": "^15.5.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{vue,js,jsx,ts,tsx}": [
      "eslint"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}